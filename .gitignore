# Code coverage profiles and other test artifacts
*.out
coverage.*
*.coverprofile
profile.cov

# Dependency directories
**/node_modules/
package-lock.json
yarn.lock
vendor/
dist/
build/
target/

# Go workspace file
go.work
go.work.sum

# env file
.env
.env.local

# Editor/IDE
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini

# Temporary cache files
cloudflare-ips.txt
*.tmp
